      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function rho = predictCurvature(Curvature0,dCurvature,Vx,PredictionHorizon)
% Curvature0       = initial curvature [1/m]
% dCurvature       = curvature derivative [1/m^2]
% Vx               = vehicle speed [m/s]
% PredictionHorizon = number of prediction samples

    % Preallocate fixed-size output
    rho = zeros(PredictionHorizon+1,1);

    % Generate time vector
    for i = 1:(PredictionHorizon+1)
        t = (i-1)*0.01;

        % Curvature prediction using clothoid model
        rho(i) = Curvature0 + dCurvature*Vx*t;
    end
end


</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
    <data SSID="5" name="rho">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
